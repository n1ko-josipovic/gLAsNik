<Page x:Class="Hub.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Hub"
    xmlns:viewmodel="clr-namespace:Hub.Client.MVVM.ViewModel"
        
    mc:Ignorable="d"
        
    Title="gLAsNik"
    Height="550" 
    Width="900"
      
    PreviewKeyDown="PageKeyDown">
    
    <Page.DataContext>
        <viewmodel:ClientViewModel />
    </Page.DataContext>

    <Border BorderThickness="1" 
        BorderBrush="#405A6A">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                        BlurRadius="25" 
                        ShadowDepth="5" 
                        Opacity="0.5"/>
        </Border.Effect>

        <Grid Background="#FFFFFF" Height="550">

            <Grid Height="90" VerticalAlignment="Top">
                <TextBlock Text="gLAsNik"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         FontSize="32"
                         FontWeight="Light"
                         Foreground="#000" Margin="25,30,0,0" Width="192"/>
                <Button Content="✕" 
                        Click="ExitButton_Click"
                        Width="42" Height="42"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        Grid.Column="1"
                        Style="{StaticResource ButtonStyle}"/>
                <Button Content="&lt;"
                        Click="BackButton_Click"
                        Width="42" Height="42"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,62,0"
                        Style="{StaticResource ButtonStyle}"/>
                <Button Content="—"
                        Click="MinimizeButton_Click"
                        Width="42" Height="42"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,104,0"
                        Style="{StaticResource ButtonStyle}"/>
            </Grid>

            <Grid Margin="0,90,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border
                    Margin="10,10,10,20">
                    <DockPanel LastChildFill="True" Margin="15">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0" Height="423">
                            <TextBlock Text="KLIJENTI" 
                            Foreground="Black" 
                            FontSize="12" 
                            Margin="5,0,0,5"/>
                            <ScrollViewer
                                        VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Disabled" 
                                        Margin="0">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"></Style>
                                </ScrollViewer.Resources>
                                <ListView ItemsSource="{Binding Users}" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Height="375"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden" d:ItemsSource="{d:SampleData ItemCount=2}"
                                    VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="5,7"
                                            Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="StatusColor"
                                                        Width="8"
                                                        Height="8"
                                                        Fill="#00E676"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Username}" 
                                                Foreground="Black"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>

                    </DockPanel>
                </Border>


                <Border Margin="10,10,10,20" Grid.Column="1">
                    <DockPanel>
                        <ListView x:Name="CommunicationArea"
                              Width="425"
                              ItemsSource="{Binding Messages}"
                              Background="Transparent"
                              BorderThickness="1,0,0,0"
                              BorderBrush="#FFABAdB3"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              d:ItemsSource="{d:SampleData ItemCount=5}">

                            <ListView.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}" />
                            </ListView.Resources>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5"
                                            Focusable="False"
                                            Background="#e4e9eb"
                                            CornerRadius="4"
                                            Padding="10">
                                        <StackPanel>
                                            <StackPanel MouseDown="CopyTextMessage">
                                                <TextBlock TextWrapping="Wrap"
                                                    FontWeight="Bold"
                                                    Text="{Binding Title}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextBlock.Foreground" Value="#000080" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Title}" Value="Poslužitelj je prestao s radom.">
                                                                    <Setter Property="Foreground" Value="#C6011F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap"
                                                           Margin="5,5,0,0"
                                                           FontFamily="Consolas"
                                                           Foreground="Black"
                                                           Text="{Binding Text}"
                                                           Visibility="{Binding ContainsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Button Content="{Binding FileName}"
                                                Command="{Binding DownloadFile}"
                                                Visibility="{Binding ContainsFile, Converter={StaticResource BooleanToVisibilityConverter }}"
                                                HorizontalAlignment="Left"
                                                Foreground="Blue"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="5,5,0,0"
                                                FontFamily="Consolas"
                                                ToolTip="Klikni kako bi preuzeo tu datoteku" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid>
                            <TextBox Name="MessageInput"
                                     PreviewKeyDown="EnterDown"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Style="{StaticResource TextBoxStyle}"
                                     Height="50"
                                     Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" 
                                     Margin="10,190,70,190" 
                                     FontFamily="Consolas"/>
                            <TextBlock Text="Poruka"
                                        Foreground="Gray"
                                        Margin="24,0,129,0"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                        Visibility="{Binding Text.IsEmpty, ElementName=MessageInput, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock
                                    Margin="10,240,70,0"
                                    FontSize="10"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Top"
                                    TextAlignment="left"
                                    FontStyle="Italic"
                                    Text="Kliknite na tekst kako biste kopirali njen sadržaj."/>
                            <Button
                                    Content="+"
                                    FontSize="16"
                                    FontWeight="Light"
                                    Height="50"
                                    Width="50"
                                    Command="{Binding PickFileCommand}"
                                    Style="{StaticResource ButtonStyle}"
                                    Background="#007AFF" 
                                    BorderBrush="#FFABAdB3"
                                    BorderThickness="1"
                                    Margin="243,190,10,190"
                                    ToolTip="Klikni kako bi odabrao datoteku"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>